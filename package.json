{
	"scripts": {
		"dev": "pnpm --parallel --filter next-app --filter @scrimflow/api run dev",
		"dev:web": "pnpm --filter next-app run dev",
		"dev:api": "pnpm --filter @scrimflow/api run dev",
		"start": "pnpm --filter next-app run start",
		"build": "pnpm --filter next-app run build",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"db:generate": "pnpm --filter @scrimflow/api run db:generate",
		"db:migrate": "pnpm --filter @scrimflow/api run db:migrate",
		"db:push": "pnpm --filter @scrimflow/api run db:push",
		"db:studio": "pnpm --filter @scrimflow/api run db:studio",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.15",
		"lefthook": "^2.1.1",
		"shadcn": "^3.8.5"
	}
}
