# Production environment for docker-compose.prod.yml.
# Copy to .env.production (gitignored) and replace every change_me_* value.
#
# Conventions:
#   (secret)   keep out of git; generate with openssl (see deployment.md Section 5).
#   internal   container-to-container address using the Docker service name.
#   public     browser-facing value; must use the public HTTPS origin.
# Only Caddy is exposed (80/443); every other service stays on the private Docker network.

# --- Datastores -------------------------------------------------------------
DB_USER=scrimflow
DB_PASSWORD=change_me_db_password          # (secret)
DB_NAME=scrimflow
REDIS_PASSWORD=change_me_redis_password    # (secret)
MINIO_USER=scrimflow_minio
MINIO_PASSWORD=change_me_minio_password    # (secret)

# DATABASE_URL / REDIS_URL must stay consistent with the credentials above.
DATABASE_URL=postgresql://scrimflow:change_me_db_password@db:5432/scrimflow   # (secret)
REDIS_URL=redis://:change_me_redis_password@cache:6379                        # (secret)

# --- Domain & origins -------------------------------------------------------
DOMAIN=scrimflow.com                       # bare domain Caddy serves the origin cert for
NEXT_PUBLIC_APP_URL=https://scrimflow.com  # public; baked into the web build and used by API email links
API_URL=http://api:3001                    # internal

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false                          # false=STARTTLS (587), true=SMTPS (465)
SMTP_USER=change_me_smtp_user              # (secret)
SMTP_PASS=change_me_smtp_password          # (secret)
SMTP_FROM=noreply@scrimflow.com

# --- Auth / crypto ----------------------------------------------------------
ENCRYPTION_KEY=change_me_base64_16_bytes   # (secret) base64 16 bytes; TOTP + recovery codes
WEBAUTHN_RP_ID=scrimflow.com
WEBAUTHN_ORIGIN=https://scrimflow.com

# --- Object storage (MinIO) -------------------------------------------------
# S3_PUBLIC_URL is served through Caddy at /assets/*; MinIO is never exposed directly.
S3_ENDPOINT=http://storage:9000            # internal
S3_ACCESS_KEY=scrimflow_minio              # same as MINIO_USER
S3_SECRET_KEY=change_me_minio_password     # (secret) same as MINIO_PASSWORD
S3_PUBLIC_URL=https://scrimflow.com/assets # public
S3_BUCKET_AVATARS=avatars
S3_BUCKET_SCREENSHOTS=screenshots
S3_BUCKET_BANNERS=banners
S3_BUCKET_HEROES=heroes
S3_BUCKET_MAPS=maps

# --- OCR (Gemini + worker) --------------------------------------------------
GEMINI_API_KEY=change_me_gemini_api_key    # (secret)
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_RPM=0                               # requests/min limit; 0 = unlimited
GEMINI_RPD=0                               # requests/day limit; 0 = unlimited
OCR_WORKER_POLL_INTERVAL_MS=4000
OCR_WORKER_LEASE_SECONDS=120
OCR_WORKER_MAX_RETRIES=3
OCR_WORKER_RETRY_BASE_MS=30000

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=info
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=change_me_base64_32_bytes   # (secret) base64 32 bytes; required for rolling deploys / multiple web containers
