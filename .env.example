# =============================================================================
# Docker Compose (infrastructure services)
# =============================================================================
DB_USER=scrimflow
DB_PASSWORD=change_me_secure_password
DB_NAME=scrimflow_db
REDIS_PASSWORD=change_me_redis_password
MINIO_USER=minio_admin
MINIO_PASSWORD=change_me_minio_password

# Domain (for production Caddy reverse proxy)
DOMAIN=localhost

# =============================================================================
# Application (shared by API + web)
# =============================================================================

# Database
DATABASE_URL=postgresql://scrimflow:change_me_secure_password@localhost:5432/scrimflow_db

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API
API_URL=http://localhost:3001

# Email (SMTP)
# Dev:  Mailpit (no auth needed, catches all mail locally)
# Prod: Resend — host=smtp.resend.com port=465 secure=true user=resend pass=re_xxxx
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@scrimflow.local

# Encryption key for TOTP secrets and recovery codes (AES)
# Generate with: openssl rand -base64 16
ENCRYPTION_KEY=change_me_to_a_secure_random_key

# Redis (optional — in-memory fallback used when unset)
REDIS_URL=redis://:change_me_redis_password@localhost:6379

# S3 / MinIO object storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=change_me_minio_password
S3_BUCKET_AVATARS=avatars
S3_BUCKET_SCREENSHOTS=screenshots
S3_BUCKET_BANNERS=banners
S3_BUCKET_HEROES=heroes
S3_BUCKET_MAPS=maps
S3_PUBLIC_URL=http://localhost:9000

# WebAuthn (Passkeys / Security Keys)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Logging (optional — defaults to "info")
LOG_LEVEL=info
