# Database Configuration
DB_USER=scrimflow
DB_PASSWORD=change_me_secure_password
DB_NAME=scrimflow_db

# Redis Configuration
REDIS_PASSWORD=change_me_redis_password

# MinIO (S3-compatible object storage)
MINIO_USER=minio_admin
MINIO_PASSWORD=change_me_minio_password
S3_PUBLIC_URL=http://localhost:9000

# Encryption key for TOTP secrets and recovery codes (AES)
# Generate with: openssl rand -base64 16
ENCRYPTION_KEY=change_me_generate_with_openssl

# Domain Configuration
# For development: localhost
# For production: your-domain.com
DOMAIN=localhost